---
import { languagesList, getI18n, htmlLang, type Lang } from '../../../i18n/ui';
import { nearbyPlaces, localizedPlace, type NearbyPlace } from '../../../data/nearby';
import { details, visitNotes } from '../../../data/nearbyDetails';
import { nearbyPhotoSource } from '../../../data/nearbyPhotos';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { siteConfig } from '../../../config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
export function getStaticPaths() { return languagesList.flatMap(lang => nearbyPlaces.map(place => ({params:{lang,slug:place[0]},props:{place}}))); }
const {place} = Astro.props as {place:NearbyPlace};
const {lang,messages}=await getI18n(Astro.url);
const p=localizedPlace(place,lang);
const info=details[place[0]];
const i=lang === 'en' ? 0 : lang === 'th' ? 1 : 2;
const fact=info.detail[i];
const visitorAngle=visitNotes[place[0]][i];
const operator=info.operator[i];
const photoAvailable=existsSync(join(process.cwd(),'public','nearby',`${place[0]}.jpg`));
const q=encodeURIComponent(`${place[1]}, ${info.kind==='shrine'?'Ratchaprasong, ':''}Bangkok, Thailand`);
const map=`https://www.google.com/maps/search/?api=1&query=${q}`;
const canonical=`${siteConfig.domain}/${lang}/nearby/${place[0]}/`;
const c={
 en:{nearby:'Nearby Bangkok guide',back:'All nearby places',explore:'Explore',about:'About this place',basics:'Visitor essentials',location:'Location',hours:'Opening hours',cost:'Admission and costs',transport:'Getting there',route:'Suggested walking route',tips:'Visiting tips',photos:'Photo viewpoints',faq:'Frequently asked questions',maps:'Find this place on Google Maps',related:'More nearby places',loc:'Ratchaprasong / central Bangkok, Thailand',hoursVal:'Check the venue’s current schedule before visiting; hours differ by venue and may change.',costVal:'Check the venue or operator for current admission or purchase requirements.',transportVal:'Use BTS and the connected pedestrian routes where convenient; verify the exact station exit and walking access on the map.',routeVal:'Start at Erawan Shrine, identify the safest crossing or skywalk route, visit this stop, then continue to another nearby landmark.',tipsVal:'Allow extra time for Bangkok traffic, heat and rain. Respect any posted rules, particularly at religious sites.',photosVal:'Photograph the entrance and distinctive details from public visitor areas; avoid blocking pedestrian access or worshippers.',q1:'How do I get here from Erawan Shrine?',a1:'Open the dedicated map search below and choose walking directions from the shrine. Follow pedestrian crossings and skywalk signs.',q2:'Can I combine this stop with the shrine?',a2:'Yes. This is one of the central Bangkok places to consider as part of a Ratchaprasong visit. Check travel time and opening arrangements first.'},
 th:{nearby:'คู่มือเที่ยวกรุงเทพฯ ใกล้ศาลเอราวัณ',back:'สถานที่ใกล้เคียงทั้งหมด',explore:'สำรวจ',about:'เกี่ยวกับสถานที่',basics:'ข้อมูลสำหรับผู้เข้าชม',location:'ที่ตั้ง',hours:'เวลาเปิดทำการ',cost:'ค่าเข้าชมและค่าใช้จ่าย',transport:'การเดินทาง',route:'เส้นทางเดินแนะนำ',tips:'คำแนะนำในการเที่ยว',photos:'มุมถ่ายภาพ',faq:'คำถามที่พบบ่อย',maps:'ดูสถานที่นี้ใน Google Maps',related:'สถานที่ใกล้เคียงอื่น ๆ',loc:'ย่านราชประสงค์ / ใจกลางกรุงเทพมหานคร ประเทศไทย',hoursVal:'ตรวจสอบเวลาทำการล่าสุดของสถานที่ก่อนเดินทาง เพราะอาจเปลี่ยนแปลงได้',costVal:'ตรวจสอบค่าเข้าชมหรือเงื่อนไขการซื้อบริการกับผู้ดูแลสถานที่โดยตรง',transportVal:'ใช้รถไฟฟ้าบีทีเอสและทางเดินเชื่อมเมื่อสะดวก ตรวจสอบทางออกสถานีและทางเดินบนแผนที่',routeVal:'เริ่มจากศาลเอราวัณ เลือกทางม้าลายหรือทางเดินลอยฟ้าที่ปลอดภัย แวะสถานที่นี้แล้วเดินทางต่อไปยังจุดหมายใกล้เคียง',tipsVal:'เผื่อเวลาสำหรับการจราจร อากาศร้อน และฝน เคารพกฎของสถานที่โดยเฉพาะศาสนสถาน',photosVal:'ถ่ายภาพทางเข้าและรายละเอียดเด่นจากพื้นที่ที่อนุญาต โดยไม่กีดขวางทางเดินหรือผู้มาสักการะ',q1:'เดินทางจากศาลเอราวัณอย่างไร?',a1:'เปิดลิงก์แผนที่ด้านล่างแล้วเลือกเส้นทางเดินเท้าจากศาล ตรวจสอบทางข้ามและทางเดินลอยฟ้า',q2:'เที่ยวร่วมกับศาลเอราวัณได้หรือไม่?',a2:'ได้ สามารถจัดไว้ในแผนเที่ยวราชประสงค์ โดยตรวจสอบเวลาเดินทางและเวลาเปิดทำการก่อน'},
 zh:{nearby:'曼谷四面佛周边指南',back:'查看全部周边景点',explore:'探索',about:'关于景点',basics:'基本游览信息',location:'所在位置',hours:'开放时间',cost:'门票与费用',transport:'交通方式',route:'建议步行路线',tips:'游览须知',photos:'拍照机位',faq:'常见问题',maps:'在 Google 地图查看该景点',related:'更多周边景点',loc:'泰国曼谷市中心／拉差帕颂商圈',hoursVal:'请在出发前核对该场所最新营业或开放时间；不同场所安排各异。',costVal:'门票、消费或预约要求请以场所运营方当前公布的信息为准。',transportVal:'可优先考虑 BTS 及相连步行通道；具体车站出口和步行入口请查看地图。',routeVal:'从四面佛出发，选择安全的人行横道或空中步道，游览此站后继续探索附近地标。',tipsVal:'曼谷市中心交通繁忙，注意防晒和雨季阵雨；宗教场所须尊重现场规定。',photosVal:'可从对公众开放的区域拍摄入口及特色细节，避免阻挡行人与参拜者。',q1:'从四面佛怎么前往？',a1:'打开下方该景点的专属地图搜索，选择从四面佛出发的步行路线，并留意天桥及人行横道。',q2:'适合与四面佛安排在同一天吗？',a2:'可以作为拉差帕颂一带行程的一站，出发前应核实实际步行时间和开放情况。'}
}[lang as Lang];
const faqs=[{q:c.q1,a:c.a1},{q:c.q2,a:c.a2}];
const article={'@type':'Article','@id':`${canonical}#article`,headline:p.title,description:p.focus,inLanguage:htmlLang[lang],mainEntityOfPage:canonical,about:{'@type':'Place',name:place[1],hasMap:map}};
const alternates=languagesList.map(l=>({lang:l,href:`${siteConfig.domain}/${l}/nearby/${place[0]}/`}));
const extra={en:{manager:'Management and background',managed:'This place is operated or cared for by',context:'The surrounding Ratchaprasong and Siam districts have developed into a meeting point of religious traditions, transit, culture and commerce. This stop adds a distinct dimension to a visit centred on the Erawan Shrine.',observe:'What to notice',experience:'Highlights and character',plan:'Plan your visit',photo:'Real photographs',mapTip:'The map opens a search for this specific place in Bangkok, not the Erawan Shrine pin.',mapLabel:'Place-specific map',history:'History and setting',historyIntro:'Its present role is best understood in the context of the changing Ratchaprasong–Siam urban district. Look for differences between older sacred or public spaces and newer transport and commercial development.',steps:['Begin at Erawan Shrine and orient yourself toward the destination using its own map pin.','Choose a signed pedestrian crossing, BTS exit or elevated walkway instead of crossing through traffic.','Spend time observing the distinctive architecture, activity and atmosphere at this stop.','Continue to another suitable landmark or return to Chit Lom BTS.'],noPhotos:'A location-matched photograph has not yet been added to this guide.'},th:{manager:'ผู้ดูแลและความเป็นมา',managed:'สถานที่นี้ดำเนินงานหรือได้รับการดูแลโดย',context:'ย่านราชประสงค์และสยามเป็นพื้นที่ที่วัฒนธรรม ความเชื่อ การคมนาคม และการค้าพบกัน สถานที่แห่งนี้ช่วยเพิ่มมุมมองใหม่ให้การเที่ยวศาลเอราวัณ',observe:'จุดสังเกต',experience:'เอกลักษณ์และสิ่งน่าสนใจ',plan:'วางแผนการเยี่ยมชม',photo:'ภาพถ่ายสถานที่จริง',mapTip:'แผนที่ค้นหาชื่อสถานที่แห่งนี้โดยเฉพาะในกรุงเทพฯ ไม่ใช่หมุดศาลเอราวัณ',mapLabel:'แผนที่เฉพาะสถานที่',history:'ประวัติและบริบท',historyIntro:'บทบาทของสถานที่นี้เกี่ยวข้องกับการพัฒนาย่านราชประสงค์และสยาม ลองสังเกตความต่างของพื้นที่ศรัทธาหรือพื้นที่สาธารณะเดิมกับระบบขนส่งและการค้าใหม่',steps:['เริ่มที่ศาลเอราวัณและเปิดหมุดจุดหมายในแผนที่','เลือกทางข้ามที่มีป้าย ทางออกบีทีเอส หรือทางเดินลอยฟ้า','ชมสถาปัตยกรรม กิจกรรม และบรรยากาศเฉพาะของสถานที่','เดินต่อสถานที่อื่นหรือกลับสถานีชิดลม'],noPhotos:'ยังไม่ได้เพิ่มภาพถ่ายที่ยืนยันตรงกับสถานที่นี้'},zh:{manager:'管理主体与历史背景',managed:'该地点目前由以下主体运营或维护：',context:'拉差帕颂与暹罗商圈是信仰、城市交通、文化与商业交汇的区域。这处地点能让以四面佛为中心的行程呈现不同的城市面貌。',observe:'观察重点',experience:'景点特色与核心体验',plan:'如何安排游览',photo:'景点实景照片',mapTip:'下方地图以该景点的专属名称及曼谷地区检索，不会统一跳回四面佛位置。',mapLabel:'专属地点地图',history:'历史脉络与场所背景',historyIntro:'理解这里的现今功能，需要把它放入拉差帕颂与暹罗地区的城市发展过程。参观时可比较早期宗教及公共空间与现代交通、商业建筑之间的关系。',steps:['从四面佛出发，先通过独立地图确认目的地所在街区。','根据路口标志选择人行横道、BTS 出口或空中步道，避免直接穿越车流。','停留观察该地点独有的建筑、活动和街区氛围。','根据体力继续游览下一处地标，或返回奇隆 BTS 站。'],noPhotos:'尚未接入已核实与该地点匹配的实景照片。'}}[lang as Lang];
---
<BaseLayout lang={lang} messages={messages} title={`${p.title} | ${c.nearby}`} description={`${p.focus}. ${c.transportVal}`} pageType="article" alternateUrls={alternates} faqs={faqs} breadcrumbs={[{name:siteConfig.name[lang],url:`${siteConfig.domain}/${lang}/`},{name:c.back,url:`${siteConfig.domain}/${lang}/nearby/`},{name:p.title,url:canonical}]} extraJsonLd={[article]} ogType="article">
  <Header lang={lang} messages={messages} page="gettingThere" languagePath={(l)=>`/${l}/nearby/${place[0]}/`} />
  <main class="bg-white text-ink">
    <section class="bg-teak text-ivory pt-28 pb-14"><div class="max-w-4xl mx-auto px-5"><a class="text-goldBright text-sm" href={`/${lang}/nearby/`}>← {c.back}</a><p class="text-gold mt-7">{c.nearby}</p><h1 class="font-display text-4xl md:text-5xl text-goldBright mt-3">{p.title}</h1><p class="mt-5 text-lg leading-relaxed max-w-2xl">{p.focus}</p><a href={map} target="_blank" rel="noopener noreferrer" class="inline-flex mt-7 bg-gold text-teak rounded-full px-6 py-3 font-semibold">📍 {c.maps} ↗</a></div></section>
    <section class="py-12 bg-ivory"><div class="max-w-4xl mx-auto px-5"><h2 class="font-display text-3xl text-teak">{c.about} {p.title}</h2><p class="mt-4 leading-relaxed">{extra.managed} <strong>{operator}</strong>.</p><p class="mt-4 leading-relaxed">{fact}</p><p class="mt-4 leading-relaxed text-ink/75">{extra.context}</p></div></section>
    <section class="py-12"><div class="max-w-4xl mx-auto px-5"><h2 class="font-display text-3xl text-teak">{extra.history}</h2><p class="mt-4 leading-relaxed">{extra.historyIntro}</p><p class="mt-4 leading-relaxed">{fact}</p><h2 class="font-display text-3xl text-teak mt-12">{extra.experience}</h2><p class="mt-4 leading-relaxed">{p.focus}. {visitorAngle}</p><h3 class="font-display text-xl text-teak mt-7">{extra.observe}</h3><p class="mt-3 leading-relaxed">{fact}</p><h2 class="font-display text-3xl text-teak mt-12">{c.basics}</h2><dl class="grid md:grid-cols-2 gap-4 mt-6">{[[c.location,c.loc],[c.hours,c.hoursVal],[c.cost,c.costVal],[c.transport,c.transportVal]].map(([a,b])=><div class="rounded-xl border border-gold/30 p-5"><dt class="font-semibold text-teak">{a}</dt><dd class="mt-2 text-sm leading-relaxed">{b}</dd></div>)}</dl></div></section>
    <section class="py-12 bg-ivory"><div class="max-w-4xl mx-auto px-5"><h2 class="font-display text-3xl text-teak">{c.route}</h2><ol class="mt-6 space-y-4 list-decimal pl-6">{extra.steps.map(step=><li class="pl-2 leading-relaxed">{step}</li>)}</ol><p class="mt-5 leading-relaxed">{visitorAngle}</p><h2 class="font-display text-3xl text-teak mt-12">{c.photos}</h2>{photoAvailable && <figure class="mt-6"><img src={`/nearby/${place[0]}.jpg`} alt={p.title} loading="lazy" class="w-full max-h-[470px] object-cover rounded-2xl"/><figcaption class="text-sm text-ink/60 mt-2">{p.title} · <a class="underline" href={nearbyPhotoSource[place[0]]} target="_blank" rel="noopener noreferrer">{place[0]==='erawan-bangkok'?'Time Out Bangkok':'Wikimedia Commons'} ↗</a></figcaption></figure>}<p class="mt-4">{c.photosVal} {visitorAngle}</p><h2 class="font-display text-3xl text-teak mt-12">{c.tips}</h2><p class="mt-4">{c.tipsVal}</p></div></section>
    <section class="py-12"><div class="max-w-4xl mx-auto px-5"><h2 class="font-display text-3xl text-teak">{c.faq}</h2>{faqs.map(f=><details class="border-b border-gold/30 py-5"><summary class="font-semibold cursor-pointer">{f.q}</summary><p class="mt-3 leading-relaxed">{f.a}</p></details>)}<h2 class="font-display text-3xl text-teak mt-12">{extra.mapLabel}</h2><p class="mt-3 text-sm text-ink/70">{extra.mapTip}</p><div class="overflow-hidden rounded-xl border border-gold/30 mt-5 h-72"><iframe title={`${p.title} Google Maps`} loading="lazy" class="w-full h-full border-0" src={`https://www.google.com/maps?q=${q}&output=embed`}></iframe></div><a href={map} target="_blank" rel="noopener noreferrer" class="inline-flex bg-teak text-ivory rounded-full px-6 py-3 mt-8">{c.maps} ↗</a></div></section>
    <section class="py-12 bg-teakDeep text-ivory"><div class="max-w-4xl mx-auto px-5"><h2 class="font-display text-2xl text-goldBright">{c.related}</h2><div class="grid sm:grid-cols-3 gap-4 mt-6">{nearbyPlaces.filter(v=>v[0]!==place[0]).slice(0,6).map(v=><a class="border border-gold/30 rounded-xl p-4 hover:border-gold" href={`/${lang}/nearby/${v[0]}/`}>{localizedPlace(v,lang).title} →</a>)}</div></div></section>
  </main>
  <Footer lang={lang} messages={messages} />
</BaseLayout>
