---
import { siteConfig } from '../config';
import { entity, fill } from '../i18n/entity';
import { pagePath, type TopicKey } from '../i18n/pages';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  topic: TopicKey;
  messages: Record<string, any>;
}

const { lang, topic, messages } = Astro.props;
const t = messages.topics[topic];
const prayer = messages.prayer;
const ui = messages.topicLinks;

/** 面包屑用的短标题（沿用首页内链卡片的标题） */
const shortTitle = ui.items.find((i: any) => i.key === topic)?.title ?? t.hero.title;

// 按站点语言切换 Google Maps 嵌入界面语言（与 MapSection 一致）
const mapLang: Record<string, [string, string]> = {
  zh: ['zh-CN', 'us'],
  en: ['en', 'us'],
  th: ['th', 'th'],
};
const [mUi, mRegion] = mapLang[lang] || ['en', 'us'];
const googleMapsEmbed = siteConfig.googleMapsEmbed.replace(
  /!1s[a-zA-Z-]+!2s[a-zA-Z]+/g,
  `!1s${mUi}!2s${mRegion}`
);
const showMap = topic === 'gettingThere' && messages.mapSection;
---

<main class="bg-white text-ink">
  <!-- Hero -->
  <section class="bg-teak pt-28 pb-14 text-ivory">
    <div class="mx-auto max-w-4xl px-5">
      <a
        href={`/${lang}/`}
        class="inline-flex items-center gap-2 text-sm text-goldBright hover:text-gold transition-colors"
      >
        <span aria-hidden="true">⬅️</span>
        {t.hero.backHome ?? prayer.hero.backHome}
      </a>

      <p class="mt-6 font-hand text-lg text-gold">{t.hero.eyebrow}</p>
      <h1 class="mt-2 font-display text-3xl leading-tight text-goldBright md:text-5xl">
        {t.hero.title}
      </h1>
      <p class="mt-5 max-w-2xl leading-relaxed text-ivory/80">{fill(t.hero.subtitle)}</p>

      <dl class="mt-8 grid gap-4 sm:grid-cols-3">
        {t.facts.map((f: any) => (
          <div class="rounded-xl border border-gold/25 bg-teakDeep/60 px-4 py-3">
            <dt class="text-xs uppercase tracking-wider text-gold">{f.label}</dt>
            <dd class="mt-1 text-sm font-semibold text-ivory">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 页内导航 -->
  <nav aria-label={prayer.tocLabel} class="border-b border-teak/10 bg-ivory">
    <div class="mx-auto max-w-4xl px-5 py-4">
      <span class="text-xs uppercase tracking-wider text-teak/60">{prayer.tocLabel}</span>
      <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {t.toc.map((item: any) => (
          <li>
            <a href={item.href} class="text-teak underline-offset-4 hover:text-gold hover:underline">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- 正文章节 -->
  {t.sections.map((s: any) => (
    <section id={s.id} class="scroll-mt-20 border-b border-teak/10 py-14 even:bg-ivory">
      <div class="mx-auto max-w-4xl px-5">
        <h2 class="font-display text-2xl text-teak md:text-3xl">{s.heading}</h2>
        {s.lead && <p class="mt-4 leading-relaxed text-ink/75">{fill(s.lead)}</p>}

        {s.items && (
          <div class="mt-8 grid gap-4 md:grid-cols-2">
            {s.items.map((it: any) => (
              <div class="rounded-2xl border border-gold/25 bg-white/60 p-5">
                <h3 class="font-display text-lg text-teak">{it.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink/70">{fill(it.desc)}</p>
              </div>
            ))}
          </div>
        )}

        {s.steps && (
          <ol class="mt-8 space-y-4">
            {s.steps.map((step: string, i: number) => (
              <li class="flex gap-4 rounded-2xl border border-gold/25 bg-white/60 p-5">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-teak font-display text-ivory">
                  {i + 1}
                </span>
                <p class="text-sm leading-relaxed text-ink/75">{fill(step)}</p>
              </li>
            ))}
          </ol>
        )}

        {s.table && (
          <div class="mt-8 overflow-x-auto rounded-2xl border border-gold/25 bg-white/60">
            <table class="w-full text-sm">
              <thead class="bg-teak text-ivory">
                <tr>
                  {s.table.columns.map((c: string) => (
                    <th scope="col" class="px-4 py-3 text-left font-semibold whitespace-nowrap">{c}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-teak/10">
                {s.table.rows.map((row: string[]) => (
                  <tr>
                    {row.map((cell: string, ci: number) => (
                      ci === 0 ? (
                        <th scope="row" class="px-4 py-3 text-left font-semibold text-teak">{cell}</th>
                      ) : (
                        <td
                          class:list={[
                            'px-4 py-3',
                            ci === 1 && row.length > 2
                              ? 'font-semibold text-gold whitespace-nowrap'
                              : 'text-ink/70',
                          ]}
                        >{cell}</td>
                      )
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {s.note && (
          <p class="mt-4 rounded-xl bg-gold/10 px-5 py-4 text-xs leading-relaxed text-ink/65">
            💡 {fill(s.note)}
          </p>
        )}
      </div>
    </section>
  ))}

  <!-- 交通页：地图嵌入 -->
  {showMap && (
    <section id="map" class="scroll-mt-20 border-b border-teak/10 py-14">
      <div class="mx-auto max-w-4xl px-5">
        <h2 class="font-display text-2xl text-teak md:text-3xl">{messages.mapSection.heading}</h2>
        <p class="mt-4 leading-relaxed text-ink/75">{messages.mapSection.lead}</p>
        <div class="mt-6 rounded-2xl overflow-hidden border border-gold/30 h-[320px]">
          <iframe
            src={googleMapsEmbed}
            width="100%"
            height="100%"
            style="border:0; display:block;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
        <p class="mt-4 text-sm text-ink/75">
          <span class="text-gold font-semibold">📍 </span>{messages.mapSection.address}
          <span class="ml-2 text-ink/50">({siteConfig.plusCode})</span>
        </p>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section id="faq" class="scroll-mt-20 border-b border-teak/10 bg-ivory py-14">
    <div class="mx-auto max-w-4xl px-5">
      <h2 class="font-display text-2xl text-teak md:text-3xl">{prayer.faqHeading}</h2>

      <div class="mt-8 space-y-3">
        {t.faqs.map((f: any) => (
          <details class="group rounded-xl border border-gold/25 bg-white px-5 py-4">
            <summary class="cursor-pointer font-semibold text-teak marker:content-none">
              {f.q}
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink/75">{fill(f.a)}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 相关页面与返回 -->
  <section class="bg-teakDeep py-14 text-ivory">
    <div class="mx-auto max-w-4xl px-5">
      <h2 class="font-display text-2xl text-goldBright md:text-3xl">{t.cta.relatedTitle}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {t.cta.related.map((r: any) => (
          <a
            href={pagePath(r.key, lang)}
            class="rounded-2xl border border-gold/30 bg-teak/40 p-5 hover:border-gold transition-colors"
          >
            <div class="font-display text-lg text-goldBright">{r.title}</div>
            <p class="mt-2 text-sm leading-relaxed text-ivory/75">{r.desc}</p>
          </a>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href={`/${lang}/`}
          class="inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3 text-sm font-semibold text-teak transition-colors hover:bg-goldBright"
        >
          <span aria-hidden="true">⬅️</span>
          {t.cta.homeLabel}
        </a>
        <a
          href={siteConfig.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-gold/50 px-6 py-3 text-sm font-semibold text-goldBright transition-colors hover:bg-gold/10"
        >
          {t.cta.mapLabel}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</main>
