---
import { siteConfig } from '../config';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const copy = {
  en: {
    copyright: `© 2026 ${siteConfig.name.en} · All rights reserved.`,
    independent: 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.',
  },
  th: {
    copyright: `© 2026 ${siteConfig.name.th} · สงวนลิขสิทธิ์`,
    independent: 'เว็บไซต์นี้เป็นโครงการข้อมูลการท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐบาลหรือองค์กรทางการใด ๆ',
  },
  zh: {
    copyright: `© 2026 ${siteConfig.name.zh} · 版權所有。`,
    independent: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。',
  },
}[lang];
---
<footer class="bg-teakDeep text-ivory py-8">
  <div class="max-w-7xl mx-auto px-5 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 text-sm text-ivory/75">
    <div class="space-y-2">
      <p>{copy.copyright}</p>
      <p>{copy.independent}</p>
    </div>
    <nav aria-label="Legal pages" class="flex flex-wrap gap-x-5 gap-y-2 lg:justify-end shrink-0 text-ivory/80">
      <a class="hover:text-goldBright underline-offset-4 hover:underline" href={`/${lang}/reviews/`}>{messages.reviews.heading}</a>
      <a class="hover:text-goldBright underline-offset-4 hover:underline" href={`/${lang}/sources/`}>{messages.sources.heading}</a>
      <a class="hover:text-goldBright underline-offset-4 hover:underline" href={`/${lang}/privacy-policy/`}>{messages.footer.privacy}</a>
      <a class="hover:text-goldBright underline-offset-4 hover:underline" href={`/${lang}/terms-of-service/`}>{messages.footer.terms}</a>
      <a class="hover:text-goldBright underline-offset-4 hover:underline" href={`/${lang}/cookie-settings/`}>{messages.footer.cookies}</a>
    </nav>
  </div>
</footer>
