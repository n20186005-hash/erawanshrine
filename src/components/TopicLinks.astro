---
import { pagePath } from '../i18n/pages';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const tl = messages.topicLinks;
---

<section id="topic-links" class="py-16 bg-ivory text-ink">
  <div class="mx-auto max-w-7xl px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{tl.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-4xl text-teak mt-2">{tl.heading}</h2>
    <p class="mt-3 max-w-2xl text-ink/70">{tl.lead}</p>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {tl.items.map((it: any) => (
        <a
          href={pagePath(it.key, lang)}
          class="group flex flex-col rounded-2xl border border-gold/25 bg-white p-6 transition-colors hover:border-gold hover:bg-teak/5"
        >
          <span class="font-display text-lg font-semibold text-teak group-hover:text-teakDeep">{it.title}</span>
          <span class="mt-2 flex-1 text-sm leading-relaxed text-ink/70">{it.desc}</span>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-gold">
            {messages.topicLinks.readMore ?? 'Read more'}
            <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
