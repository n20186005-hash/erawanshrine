---
import { siteConfig } from '../config';
import { languages, languagesList, type Lang } from '../i18n/ui';
import { pagePath, type PageKey } from '../i18n/pages';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
  /** 当前页面：决定锚点是否需要补语言前缀，以及语言切换跳转到哪一页 */
  page?: PageKey;
}
const { lang, messages, page = 'home' } = Astro.props;
const h = messages.header;

const homeBase = `/${lang}/`;

/**
 * 导航里的锚点都指向首页区块。
 * 在首页上保留纯锚点（#about）以便平滑滚动；在二级页上必须补语言前缀，
 * 否则点击后原地不动。
 */
const anchor = (hash: string) => (page === 'home' ? hash : `${homeBase}${hash}`);

const navItems = [
  { label: h.home, href: page === 'home' ? '#home' : homeBase },
  { label: h.about, href: anchor('#about') },
  { label: h.history, href: anchor('#history') },
  { label: h.guide, href: anchor('#guide') },
  { label: h.prayer, href: pagePath('prayer', lang) },
  { label: h.food, href: anchor('#food') },
  { label: h.gallery, href: anchor('#gallery') },
  { label: h.reviews, href: anchor('#reviews') },
  { label: h.map, href: anchor('#map') },
];

/** 语言切换要留在同一页面：从泰文经文页切到中文，应到达中文经文页而非中文首页 */
const switchTo = (target: Lang) => pagePath(page, target);
---

<header class="fixed top-0 inset-x-0 z-50 bg-teak/90 backdrop-blur-md border-b border-gold/20">
  <div class="max-w-7xl mx-auto px-5 h-16 flex items-center justify-between">
    <a href={`/${lang}/`} class="font-display text-goldBright tracking-wide text-lg whitespace-nowrap">
      {siteConfig.name[lang]}
    </a>

    <nav class="hidden md:flex items-center gap-3 lg:gap-5 text-xs lg:text-sm text-ivory/80">
      {navItems.map((item) => (
        <a href={item.href} class="hover:text-goldBright transition-colors whitespace-nowrap">{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <div class="flex items-center rounded-full border border-gold/30 overflow-hidden text-xs">
        {languagesList.map((l) => (
          <a
            href={switchTo(l)}
            class={`px-2.5 py-1 transition-colors ${l === lang ? 'bg-gold text-teak font-semibold' : 'text-ivory/80 hover:text-goldBright'}`}
          >
            {languages[l]}
          </a>
        ))}
      </div>
      <button id="menu-btn" class="md:hidden text-ivory p-2" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden md:hidden border-t border-gold/20 bg-teakDeep">
    <div class="max-w-7xl mx-auto px-5 py-3 grid grid-cols-2 gap-2 text-sm text-ivory/80">
      {navItems.map((item) => (
        <a href={item.href} class="py-1.5 hover:text-goldBright transition-colors">{item.label}</a>
      ))}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
