---
import { pagePath } from '../i18n/pages';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const cta = messages.prayerEntry;
if (!cta) return null;
---

<!--
  通往「经文与参拜指南」二级页的入口卡片。
  放在官方规章区块之后：读者刚看完还愿价目与参拜规定，正是最可能想深入了解
  「怎么拜、念什么」的位置。锚文本使用目标页的核心关键词而非「了解更多」。
-->
<section class="bg-white border-t border-teak/10 py-12">
  <div class="max-w-7xl mx-auto px-5">
    <a
      href={pagePath('prayer', lang)}
      class="group flex flex-col md:flex-row md:items-center gap-5 md:gap-8 rounded-2xl border border-gold/30 bg-ivory p-6 md:p-8 shadow-sm hover:border-gold hover:shadow-md transition-all"
    >
      <span class="text-4xl leading-none" aria-hidden="true">{cta.icon}</span>
      <div class="flex-1">
        <h2 class="font-display text-xl md:text-2xl text-teak group-hover:text-gold transition-colors">
          {cta.title}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-ink/70">{cta.desc}</p>
      </div>
      <span class="inline-flex items-center gap-2 self-start md:self-center whitespace-nowrap rounded-full bg-teak px-5 py-2.5 text-sm font-semibold text-ivory group-hover:bg-gold group-hover:text-teak transition-colors">
        {cta.label}
        <span aria-hidden="true">→</span>
      </span>
    </a>
  </div>
</section>
