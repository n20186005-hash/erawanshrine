---
import { pagePath } from '../i18n/pages';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const g = messages.interactiveGuide;
if (!g) return null;
---

<section id="interactive-guide" class="py-16 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-10">
      <h2 class="font-display font-semibold text-3xl md:text-4xl text-teak">{g.heading}</h2>
      <p class="mt-3 text-ink/70">{g.intro}</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10 items-center">
      <!-- Interactive Map -->
      <div class="relative w-full max-w-sm mx-auto aspect-square bg-teak/5 rounded-full border-2 border-dashed border-gold/30 flex items-center justify-center mt-8">
        <!-- Center Shrine -->
        <div class="absolute w-24 h-24 bg-gold rounded-sm rotate-45 flex items-center justify-center shadow-lg z-10">
          <span class="text-teak font-bold -rotate-45">{g.centerLabel}</span>
        </div>

        <!-- 4 Faces Buttons -->
        {g.faces.map((f: any, i: number) => (
          <button
            class:list={[
              'face-btn absolute px-4 py-2 rounded-full shadow-md whitespace-nowrap z-20 transition-colors',
              i === 0 && '-bottom-6 left-1/2 -translate-x-1/2 bg-gold text-white hover:bg-goldBright',
              i === 1 && 'top-1/2 -left-8 -translate-y-1/2 bg-white border border-gold text-teak hover:bg-gold hover:text-white',
              i === 2 && '-top-6 left-1/2 -translate-x-1/2 bg-white border border-gold text-teak hover:bg-gold hover:text-white',
              i === 3 && 'top-1/2 -right-8 -translate-y-1/2 bg-white border border-gold text-teak hover:bg-gold hover:text-white',
            ]}
            data-face={i + 1}
          >
            {f.btn}
          </button>
        ))}

        <div class="absolute inset-0 pointer-events-none rounded-full border-[16px] border-transparent border-t-gold/20 -rotate-45"></div>
        <span class="absolute top-[15%] left-[15%] text-xs text-gold/80 -rotate-45">{g.clockwise}</span>
      </div>

      <!-- Info Card -->
      <div class="bg-white rounded-2xl p-6 md:p-8 shadow-xl border border-teak/10 min-h-[250px] mt-8 lg:mt-0">
        <h3 id="face-title" class="font-display text-2xl text-teak mb-4 border-b border-gold/20 pb-3">{g.faces[0].title}</h3>
        <div class="space-y-4">
          <div>
            <div class="text-xs uppercase tracking-wider text-gold font-semibold mb-1">{g.themeLabel}</div>
            <p id="face-theme" class="text-ink/85 font-medium text-lg">{g.faces[0].theme}</p>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-gold font-semibold mb-1">{g.offeringLabel}</div>
            <p id="face-offering" class="text-ink/85">{g.faces[0].offering}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 内链到经文与参拜指南二级页 -->
    <div class="mt-12 text-center">
      <a href={pagePath('prayer', lang)} class="inline-flex items-center gap-2 bg-teak text-ivory px-6 py-3 rounded-full hover:bg-teakDeep transition-colors shadow-md">
        <span aria-hidden="true">📖</span>
        <span>{g.linkLabel}</span>
      </a>
      <p class="mt-3 text-sm text-ink/60 max-w-xl mx-auto">{g.linkDesc}</p>
    </div>
  </div>
</section>

<script is:inline define:vars={{ faceData: g.faces }}>
  document.querySelectorAll('.face-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      // reset styles
      document.querySelectorAll('.face-btn').forEach(b => {
        b.classList.remove('bg-gold', 'text-white');
        b.classList.add('bg-white', 'text-teak');
      });
      // set active
      e.currentTarget.classList.remove('bg-white', 'text-teak');
      e.currentTarget.classList.add('bg-gold', 'text-white');

      const face = e.currentTarget.getAttribute('data-face');
      const data = faceData[Number(face) - 1];
      if (data) {
        document.getElementById('face-title').textContent = data.title;
        document.getElementById('face-theme').textContent = data.theme;
        document.getElementById('face-offering').textContent = data.offering;
      }
    });
  });
</script>
